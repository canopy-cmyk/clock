<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Sin permiso INTERNET: la app no puede enviar ni recibir nada de la red. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <application
        android:name=".ClockApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="Clock"
        android:supportsRtl="true"
        android:theme="@style/Theme.Clock">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SHOW_ALARMS" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <activity
            android:name=".alarm.AlarmActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleInstance"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:taskAffinity=".ring" />

        <activity
            android:name=".nightstand.NightstandActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:screenOrientation="unspecified"
            android:showWhenLocked="true"
            android:theme="@style/Theme.Clock.Fullscreen" />

        <service
            android:name=".alarm.RingService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE" android:value="Alarma o temporizador sonando" />
        </service>

        <service
            android:name=".alarm.IntervalService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE" android:value="Programa de intervalos en curso" />
        </service>

        <service
            android:name=".nightstand.ClockDream"
            android:exported="true"
            android:label="Clock · modo reloj"
            android:permission="android.permission.BIND_DREAM_SERVICE">
            <intent-filter>
                <action android:name="android.service.dreams.DreamService" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </service>

        <receiver android:name=".alarm.AlarmReceiver" android:exported="false" />
        <receiver android:name=".alarm.ActionReceiver" android:exported="false" />
        <receiver android:name=".widget.WidgetFuncional" android:label="Reloj · Funcional" android:exported="false">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_funcional" />
        </receiver>
        <receiver android:name=".widget.WidgetInstrumento" android:label="Reloj · Instrumento" android:exported="false">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_instrumento" />
        </receiver>
        <receiver android:name=".widget.WidgetBloque" android:label="Reloj · Bloque" android:exported="false">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_bloque" />
        </receiver>
        <receiver android:name=".widget.WidgetPedestal" android:label="Reloj · Pedestal" android:exported="false">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_pedestal" />
        </receiver>
        <receiver android:name=".widget.WidgetMadera" android:label="Reloj · Madera" android:exported="false">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_madera" />
        </receiver>
        <receiver android:name=".widget.WidgetLcd" android:label="Reloj · LCD" android:exported="false">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_lcd" />
        </receiver>
        <receiver android:name=".widget.WidgetTubos" android:label="Reloj · Tubos" android:exported="false">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_tubos" />
        </receiver>
        <receiver android:name=".widget.WidgetMatriz" android:label="Reloj · Matriz" android:exported="false">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_matriz" />
        </receiver>
        <receiver android:name=".widget.WidgetCubo" android:label="Reloj · Cubo" android:exported="false">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_cubo" />
        </receiver>
        <receiver android:name=".widget.WidgetRadio" android:label="Reloj · Radio" android:exported="false">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_radio" />
        </receiver>
        <receiver android:name=".widget.WidgetTorre" android:label="Reloj · Torre" android:exported="false">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_torre" />
        </receiver>
        <receiver android:name=".widget.WidgetTelevisor" android:label="Reloj · Televisor" android:exported="false">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_televisor" />
        </receiver>
        <receiver android:name=".widget.WidgetDespertador" android:label="Reloj · Despertador" android:exported="false">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_despertador" />
        </receiver>
        <receiver android:name=".widget.WidgetMesilla" android:label="Reloj · Mesilla" android:exported="false">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_mesilla" />
        </receiver>
        <receiver android:name=".widget.WidgetEstrella" android:label="Reloj · Estrella" android:exported="false">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_estrella" />
        </receiver>
    </application>
</manifest>
